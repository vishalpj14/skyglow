{
  "name": "skyglow-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Skyglow in the browser: the Rust core compiled to WebAssembly, with a Vue 3 interface.",
  "license": "MIT",
  "scripts": {
    "wasm": "node scripts/build-wasm.mjs",
    "dev": "npm run wasm && vite",
    "build": "npm run wasm && vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "npm run wasm && vitest run",
    "typecheck": "vue-tsc --noEmit"
  },
  "dependencies": {
    "leaflet": "1.9.4",
    "marked": "18.2.0",
    "vue": "3.5.45"
  },
  "devDependencies": {
    "@types/leaflet": "1.9.22",
    "@types/node": "24.19.2",
    "@vitejs/plugin-vue": "6.0.11",
    "@vue/tsconfig": "0.9.1",
    "typescript": "5.9.3",
    "vite": "8.3.8",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.1.0",
    "vue-tsc": "3.3.14"
  }
}
